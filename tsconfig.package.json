{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist-package",
    "rootDir": "src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/index.ts",
    "src/engine/**/*.ts",
    "src/effects/**/*.ts",
    "src/lib/registry.ts",
    "src/export/**/*.ts"
  ],
  "exclude": ["**/*.test.ts"]
}
